# ─────────────────────────────────────────────────────────────────────────────
# Backend Environment Variables — EasyPG
# COPY THIS FILE TO .env AND FILL IN REAL VALUES
# NEVER commit .env — it contains secrets
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
# Get from Supabase → Project Settings → Database → Connection String
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true&connection_limit=15"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ─── Authentication ──────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# MUST be a long random string — minimum 64 characters
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ─── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# ─── Redis (optional — defaults to in-memory if not set) ─────────────────────
REDIS_URL=redis://localhost:6379

# ─── Development Only ────────────────────────────────────────────────────────
# Set to true ONLY in dev to skip Supabase auth. NEVER in production.
ENABLE_MOCK_AUTH=false

# ─── Default Passwords (via env — never hardcode in source) ──────────────────
# These are used when creating staff/warden accounts without explicit password
DEFAULT_WARDEN_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
DEFAULT_STAFF_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
DEFAULT_USER_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

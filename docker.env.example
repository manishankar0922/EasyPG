# =============================================================================
# docker.env.example — secrets for the Docker Compose stack (docker-compose.yml)
#
# 1. Copy this file to .env.docker
#      cp docker.env.example .env.docker
# 2. Fill in REAL values for everything marked REQUIRED.
# 3. Run:  npm run docker:up
#
# .env.docker is git-ignored (see root .gitignore: .env*). NEVER commit secrets.
# These values are substituted into docker-compose.yml at `docker compose` time.
# =============================================================================

# ─── Postgres (local container) ──────────────────────────────────────────────
POSTGRES_USER=easypg
POSTGRES_PASSWORD=easypg
POSTGRES_DB=easypg
POSTGRES_PORT=5432
REDIS_PORT=6379

# ─── Backend secrets ─────────────────────────────────────────────────────────
# REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET

# Cloudinary (REQUIRED for image uploads to work)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Supabase (auth). Leave blank for local-only runs that use ENABLE_MOCK_AUTH.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Set to true ONLY for local dev to bypass real Supabase auth. NEVER in real prod.
ENABLE_MOCK_AUTH=false

# ─── Frontend (NEXT_PUBLIC_* — inlined into client bundle at BUILD time) ─────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
